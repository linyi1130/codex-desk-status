# Copy to host/.env if you want to override the defaults.
# The process also reads the same variable names from the environment.
# Do not put OpenAI or Codex tokens here. This sidecar never reads them.

# CODEX_HOME=/Users/you/.codex
# CODEX_STATUS_HOST=0.0.0.0
# CODEX_STATUS_PORT=8787
# CODEX_STATUS_MDNS_NAME=codex-status
# CODEX_STATUS_ADVERTISE_IP=
# CODEX_STATUS_POLL=0.8

# Optional shared token. When set, GET /status and GET /events from other
# machines must send the header  X-Status-Token: <token>.  /health stays open;
# loopback clients (the local browser preview) need no header.  Generate one
# yourself, e.g.  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# and put the same value in the firmware's config.h as CODEX_TOKEN.
# CODEX_STATUS_TOKEN=
